# Set in server environment; never expose in VITE_ variables.
PORT=3001
DATA_DIR=./data
# ADMIN_TOKEN=generate-a-long-random-token

# Optional handwriting recognition. Keep this key on the SERVER only.
# The app reads .env at startup. Restart the server after changing it.
# OPENAI_API_KEY=your-server-side-key
OPENAI_VISION_MODEL=gpt-4.1-mini

# Plot/export archive. Defaults to DATA_DIR/activity.
# Keep outside the public/dist directory and on persistent storage.
# ACTIVITY_DIR=./data/activity
