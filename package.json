{
  "name": "liberia-field-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "activity:logs": "tsx scripts/activity-log.ts",
    "cf:check": "tsc -p cloudflare/tsconfig.json --noEmit",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:bucket": "wrangler r2 bucket create field-atlas-files"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "@turf/turf": "^7.2.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "maplibre-gl": "^5.6.0",
    "papaparse": "^5.5.3",
    "proj4": "^2.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "miniflare": "^5.20260907.0-alpha",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22"
  }
}
