{
 "$schema":"../node_modules/wrangler/config-schema.json",
 "name":"field-atlas-backend",
 "main":"worker.ts",
 "compatibility_date":"2026-09-08",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,
 "preview_urls":false,
 "r2_buckets":[{"binding":"FILES","bucket_name":"field-atlas-files"}],
 "durable_objects":{"bindings":[{"name":"ATLAS","class_name":"Atlas"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["Atlas"]}],
 "triggers":{"crons":["0 */6 * * *"]},
 "vars":{"OPENAI_VISION_MODEL":"gpt-4.1-mini"}
}
